      "name": "Elder Zero",
      "x": 18,
      "y": 7,
      "facing": "left",
      "type": "npc",
      "dialogue": [
        "Zeroville has stood since before anyone can remember.",
        "The professor's shield keeps the glitch at bay.",
        "Route 1 lies to the east — be careful out there!"
      ],

      "type": "dialogue",
      "dialogue": [
        {
          "en": "Hello!",
          "he": "שלום! אני עוזרת מחקר של סוגי פוקימונים."
        },
        {
          "en": "",
          "he": "כל סוג פוקימון יש לו יתרונות וחסרונות."
        },
        {
          "en": "",
          "he": "תוכל ללמוד על כך בפקודיע שלך ."
        },
        {
          "en": "",
          "he": "לחץ על כפתור D באנגלית או ג' בעברית."
        },
        {
          "en": "",
          "he": "ואז תשחק עם הפקודיע ."
        },
        {
          "en": "",
          "he": "כשמשתמשים בפקוידע במהלך קרב , אז הבטריה עלולה להתרוקן."
        },
        {
          "en": "",
          "he": "במרכז הפוקימונים ימלאו לך את הסוללה במהירות ובחינם."
        },
        {
          "en": "",
          "he": "אך אם תתקע - כדאי שיהיה לך סוללות גיבוי."
        }
      ],

  "npcs": [
    {
      "id": "npc-1774305358586",
      "x": 1,
      "y": 3,
      "facing": "up",
      "type": "dialogue",
      "dialogue": [
        {
          "en": "My dad makes the most amazing soup! He says it gives Pokemon back their strength.",
          "he": "אבא שלי מכין מרק מדהים! הוא אומר שזה נותן לפוקימונים בחזרה את כוחם."
        },
        {
          "en": "A Pokemon that drinks a full serving can recover completely — even from fainting!",
          "he": "פוקימון ששותה מנה מלאה יכול להתאושש לחלוטין — אפילו מהתעלפות!"
        },
        {
          "en": "One day I will be a Pokemon trainer too!",
          "he": "יום אחד גם אני אהיה מאמן פוקימון!"
        }
      ],
      "spriteType": "char_0502ea",
      "name": {
        "en": "Tom",
        "he": "Tom"
      },
      "reward": {
        "money": 0,
        "items": [
          {
            "itemId": "max-revive",
            "quantity": 1
          }
        ]
      }
    },
    {
      "id": "npc-1774900552509",
      "x": 8,
      "y": 7,
      "facing": "down",
      "type": "dialogue",
      "dialogue": [
        {
          "en": "Welcome! I am Rick, and I brew a special soup that restores fallen Pokemon.",
          "he": "ברוך הבא! אני ריק, ואני מבשל מרק מיוחד שמחזיר פוקימון שנפלו."
        },
        {
          "en": "The shops sell it as a 'Revive'. In Hebrew that's 'רבייב' — it means 'to bring back to life'.",
          "he": "החנויות מוכרות את זה בתור 'Revive'. בעברית זה 'רבייב' — זה אומר 'להקים לתחיה'."
        },
        {
          "en": "A fainted Pokemon that receives a Revive can fight again right away. Keep a few in your bag at all times!",
          "he": "פוקימון מותש שמקבל רבייב יכול לחזור ולהילחם מיד. שמור כמה בתיק שלך כל הזמן!"
        },
        {
          "en": "Here, take some Revives to get you started on your journey!",
          "he": "הנה, קח כמה רבייבים כדי להתחיל את המסע שלך!"
        }
      ],
      "spriteType": "char_8c60a6",
      "name": {
        "en": "Rick",
        "he": "Rick"
      },

  "npcs": [
    {
      "id": "zeroville-house2-npc",
      "x": 1,
      "y": 3,
      "facing": "right",
      "type": "dialogue",
      "dialogue": [
        {
          "en": "Hey, I'm Elan! I live right next to the lab, so I know a thing or two.",
          "he": "היי, אני אלן! אני גר ממש ליד המעבדה, אז אני יודע דבר או שניים."
        },
        {
          "en": "When your Pokemon faints — meaning its HP reaches zero — it can't battle anymore until you heal it.",
          "he": "כשהפוקימון שלך מתעלף — כלומר ה-HP שלו מגיע לאפס — הוא לא יכול להילחם יותר עד שתרפא אותו."
        },
        {
          "en": "Use a Revive to wake it up right away! Or visit the Pokemon Center — it's free!",
          "he": "השתמש ב-Revive כדי להעירו מיד! או בקר במרכז הפוקימון — זה בחינם!"
        },
        {
          "en": "Strange things are indeed stirring outside our town... Prof. Algorithma is worried. Stay alert out there!",
          "he": "דברים מוזרים אכן מתרחשים מחוץ לעיירה שלנו... פרופ׳ אלגוריתמה מוטרדת. היה ערני שם בחוץ!"
        }
      ],
      "spriteType": "char_392694",
      "name": {
        "en": "Elan",
        "he": "Elan"
      }
    }
  ],

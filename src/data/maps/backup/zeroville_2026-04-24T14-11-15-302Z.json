  "npcs": [
    {
      "id": "elder-zero",
      "name": {
        "en": "Elder Zero",
        "he": "Elder Zero"
      },
      "x": 23,
      "y": 6,
      "facing": "down",
      "type": "dialogue",
      "dialogue": [
        {
          "en": "Halt, young one! You must receive your partner Pokemon from Prof. Algorithma before venturing onto Route 1.",
          "he": "עצור! עליך לקבל את פוקימון השותף שלך מפרופ׳ אלגוריתמה לפני שתצא לדרך 1."
        },
        {
          "en": "Her lab is in the south of town. Go speak with her first!",
          "he": "המעבדה שלה נמצאת בדרום העיר. לך לדבר איתה קודם!"
        }
      ],
      "spriteType": "char_a5abb0",
      "autoWalk": null,
      "lineOfSight": 2,
      "blocker": true,
      "despawnAfter": "story-received-starter"
    },
    {
      "id": "kid-origin",
      "name": {
        "en": "Little Null",
        "he": "Little Null"
      },
      "x": 5,
      "y": 16,
      "facing": "right",
      "type": "dialogue",
      "dialogue": [
        {
          "en": "I want to be a Pokemon trainer someday!",
          "he": "אני רוצה להיות מאמן פוקימון יום אחד!"
        },
        {
          "en": "Did you know Pokeballs are the best way to catch wild Pokemon?",
          "he": "ידעת שכדורי פוקה הם הדרך הטובה ביותר לתפוס פוקימון בר?"
        },
        {
          "en": "Weaken the wild Pokemon first — then throw a Pokeball! The lower its HP, the better your chances!",
          "he": "תחלש תחילה את הפוקימון הפראי — אחר כך זרוק כדור פוקה! ככל שה-HP שלו נמוך יותר, כך הסיכויים שלך גבוהים יותר!"
        }
      ],
      "spriteType": "char_0502ea"
    },
    {
      "id": "shop-helper",
      "name": {
        "en": "Ben",
        "he": "בן"
      },
      "x": 16,
      "y": 17,
      "facing": "up",
      "type": "dialogue",
      "dialogue": [
        {
          "en": "Welcome to the Mart! We have everything a new trainer needs.",
          "he": "תצטייד לפני שאתה יוצא לדרך 1 — פוקימון פראיים יכולים להפתיע אותך שם בחוץ!"
        },
        {
          "en": "A Potion restores 20 HP to your Pokemon. Think of it as a healing spray!",
          "he": "תדאג תמיד למלאי של שיקויים ופוקדורים."
        },
        {
          "en": "Stock up before heading to Route 1 — wild Pokemon can surprise you out there!",
          "he": ""
        }
      ],
      "spriteType": "char_95ee55",
      "autoWalk": {
        "pattern": [
          {
            "dir": "right",
            "steps": 5,
            "delay": 2
          },
          {
            "dir": "left",
            "steps": 5,
            "delay": 2
          },
          {
            "dir": "down",
            "steps": 2,
            "delay": 1
          },
          {
            "dir": "up",
            "steps": 2,
            "delay": 1
          }
        ],
        "loop": true
      },
      "reward": {
        "money": 0,
        "items": [
          {
            "itemId": "poke-ball",
            "quantity": 1
          }
        ]
      }
    },
    {
      "id": "helpful-npc-1",
      "name": {
        "en": "Kind Kara",
        "he": "Kind Kara"
      },
      "x": 12,
      "y": 10,
      "facing": "down",
      "type": "dialogue",
      "dialogue": [
        {
          "en": "Hey there, new trainer! You look like you're just starting out.",
          "he": "הי, מאמן חדש! נראה שאתה רק מתחיל."
        },
        {
          "en": "Here, take these! Potions heal your Pokemon and Pokeballs let you catch new ones.",
          "he": "הנה, קח אלה! פוציונים מרפאים את הפוקימון שלך וכדורי פוקה מאפשרים לך לתפוס חדשים."
        },
        {
          "en": "Remember: open your bag during battle to use items. Good luck out there!",
          "he": "זכור: פתח את התיק שלך במהלך קרב כדי להשתמש בפריטים. בהצלחה בחוץ!"
        }
      ],
      "spriteType": "char_0502ea",
      "reward": {
        "items": [
          {
            "itemId": "potion",
            "quantity": 3
          },
          {
            "itemId": "poke-ball",
            "quantity": 5
          }
        ],
        "money": 100,
        "flag": "npc-helpful-1-rewarded"
      }
    },
    {
      "id": "forest-guard-max",
      "name": {
        "en": "Max",
        "he": "Max"
      },
      "x": 8,
      "y": 1,
      "facing": "right",
      "type": "dialogue",
      "dialogue": [
        {
          "en": "The Deep Forest to the north is no place for a beginner!",
          "he": "היער העמוק בצפון אינו מקום למתחילים!"
        },
        {
          "en": "The wild Pokemon there are vicious. Come back when your partner is stronger — at least level 5!",
          "he": "פוקימוני הבר שם פראיים. חזור כשהשותף שלך חזק יותר — לפחות רמה 5!"
        }
      ],
      "spriteType": "char_0502ea",
      "lineOfSight": 3,
      "blocker": true,
      "despawnWhenParty": {
        "count": 1,
        "minLevel": 25
      }
    },
    {
      "id": "route9-guard",
      "name": {
        "en": "South Gate Warden",
        "he": "South Gate Warden"
      },
      "x": 10,
      "y": 23,
      "facing": "left",
      "type": "dialogue",
      "dialogue": [
        {
          "en": "Route 9 leads far to the south — it is not ready for travelers yet.",
          "he": "דרך 9 מובילה רחוק דרומה — היא עדיין לא מוכנה לנוסעים."
        },
        {
          "en": "Focus on your journey east through Route 1 for now.",
          "he": "התמקד במסע שלך מזרחה דרך דרך 1 לעת עתה."
        }
      ],
      "spriteType": "char_a5abb0",
      "lineOfSight": 4,
      "blocker": true,
      "despawnWhenParty": {
        "count": 3,
        "minLevel": 15
      }
    },
    {
      "id": "battle-tutor-zeroville",
      "name": {
        "en": "Trainer Scout",
        "he": "Trainer Scout"
      },
      "x": 13,
      "y": 20,
      "facing": "up",
      "type": "dialogue",
      "dialogue": [
        {
          "en": "Battles are the heart of a trainer's journey!",
          "he": "קרבות הם לב מסע המאמן!"
        },
        {
          "en": "In a battle, your Pokemon and the opponent take turns attacking. Choose a move wisely!",
          "he": "בקרב, הפוקימון שלך והיריב מתחלפים בתקיפה. בחר מהלך בחכמה!"
        },
        {
          "en": "If your Pokemon's HP drops to zero, it faints. Use a Revive or visit the Pokemon Center to heal it!",
          "he": "אם ה-HP של הפוקימון שלך יורד לאפס, הוא מתעלף. השתמש ב-Revive או בקר במרכז הפוקימון כדי לרפא אותו!"
        }
      ],
      "spriteType": "char_392694"
    },
    {
      "id": "pokecenter-hint",
      "name": {
        "en": "Nurse Joy",
        "he": "Nurse Joy"
      },
      "x": 12,
      "y": 15,
      "facing": "down",
      "type": "dialogue",
      "dialogue": [
        {
          "en": "The Pokemon Center heals all your Pokemon for free!",
          "he": "מרכז הפוקימון מרפא את כל הפוקימונים שלך בחינם!"
        },
        {
          "en": "If your whole team faints in battle, you will wake up in the nearest Pokemon Center.",
          "he": "אם כל הצוות שלך מתעלף בקרב, תתעורר במרכז הפוקימון הקרוב ביותר."
        },
        {
          "en": "Always heal before heading into tall grass or facing a tough trainer!",
          "he": "תמיד תרפא לפני שאתה נכנס לדשא גבוה או מתמודד עם מאמן קשה!"
        }
      ],
      "spriteType": "char_c3dacc"
    }
  ],

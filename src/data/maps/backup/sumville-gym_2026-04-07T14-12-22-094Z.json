        }
      ],
      "reward": {
        "money": 416
      },
      "lineOfSight": 4,
      "despawnOnDefeat": true,
      "postBattleDialogue": [
        {
          "en": "The sum of your skill is greater than mine...",
          "he": "סך הכל הכישורים שלך גדולים משלי..."
        }
      ]
    },
    {
      "id": "gym-trainer-2",
      "name": "Gym Trainer Summa",
      "x": 13,
      "y": 9,
      "facing": "left",
      "type": "trainer",
      "dialogue": [
        {
          "en": "Two trainers down plus one equals three obstacles total. I'm obstacle two!",
          "he": "שני מאמנים בתוספת אחד שווה שלושה מכשולים בסה\"כ. אני המכשול השני!"
        }
      ],
      "spriteType": "char_a5abb0",
      "party": [
        {
          "pokemonId": 23,
          "level": 13,
          "moves": []
        },
        {
          "pokemonId": 100,
          "level": 14,
          "moves": []
        },
        {
          "pokemonId": 43,
          "level": 14,
          "moves": []
        }
      ],
      "reward": {
        "money": 448
      },
      "lineOfSight": 4,
      "despawnOnDefeat": true,
      "postBattleDialogue": [
        {
          "en": "1 + 1 + 1 = 3... and three losses for me today.",
          "he": "1 + 1 + 1 = 3... ושלוש הפסדות בשבילי היום."
        }
      ]
    },
    {
      "id": "gym-trainer-3",
      "name": "Gym Trainer Carry",
      "x": 7,
      "y": 5,
      "facing": "down",
      "type": "trainer",
      "dialogue": [
        {
          "en": "I always carry the one! My Pokemon have fought many trainers and added every victory!",
          "he": "אני תמיד נושא את האחת! הפוקימונים שלי נלחמו במאמנים רבים וצברו כל ניצחון!"
        }
      ],
      "spriteType": "char_485c6e",
      "party": [
        {
          "pokemonId": 20,
          "level": 14,
          "moves": []
        },
        {
          "pokemonId": 40,
          "level": 15,
          "moves": []
        },
        {
          "pokemonId": 86,
          "level": 15,
          "moves": []
        },
        {
          "pokemonId": 190,
          "level": 14,
          "moves": []
        }
      ],
      "reward": {
        "money": 480
      },
      "lineOfSight": 4,
      "despawnOnDefeat": true,
      "postBattleDialogue": [
        {
          "en": "I carried too much... You've earned the right to face Adda.",
          "he": "נשאתי יותר מדי... הרווחת את הזכות לעמוד מול אדה."
        }
      ]
    },
    {
      "id": "adda-gym-leader",
      "name": "Adda",
      "x": 9,
      "y": 2,
      "facing": "down",
      "type": "trainer",
      "spriteType": "char_962c1b",
      "spawnAfter": "sumville-crystal-returned",
      "dialogue": [
        {
          "en": "I'm Adda, leader of the Addition Gym.",
          "he": "אני אדה, מנהיגת מכון של החיבור."
        },
        {
          "en": "Thanks to you, the bridge crystal is safe. Now prove your worth as a trainer!",
          "he": "בזכותך, גביש הגשר בטוח. עכשיו הוכח את ערכך כמאמן!"
        },
        {
          "en": "When all elements add together, the total is greater than any single part. Show me your sum!",
          "he": "כשכל האלמנטים מתחברים, הסך גדול מכל חלק בודד. הראה לי את הסכום שלך!"
        }
      ],
      "party": [
        {
          "pokemonId": 35,
          "level": 16,
          "moves": []
        },
        {
          "pokemonId": 39,
          "level": 17,
          "moves": []
        },
        {
          "pokemonId": 143,
          "level": 18,
          "moves": []
        }
      ],
      "reward": {
        "money": 1800,
        "badge": 1,
        "storyEvent": "sumville-gym-cleared",
        "items": [
          {
            "itemId": "hm01",
            "quantity": 1
          }
        ]
      },
      "lineOfSight": 5,
      "postBattleDialogue": [
        {
          "en": "Impressive! You've earned the Sum Badge — proof of your addition of strength and wisdom.",
          "he": "מרשים! הרווחת את תג הסכום — הוכחה לחיבור הכוח והחוכמה שלך."
        },
        {
          "en": "Take this — HM01, Cut.",
          "he": "קח את זה — HM01, גזירה."
        },
        {
          "en": "Teach Cut to one of your Pokemon. In battle, it slices the target cleanly.",
          "he": "למד גזירה לאחד מהפוקימונים שלך. בקרב, היא חותכת את המטרה בצורה נקייה."
        },
        {
          "en": "But Cut's real power shines in the overworld. See those small trees with marked trunks?",
          "he": "אבל הכוח האמיתי של הגזירה מתגלה בעולם. רואה את העצים הקטנים עם גזעים מסומנים?"
        },
        {
          "en": "A Pokemon with Cut can slice them down, opening new paths that were blocked before.",
          "he": "פוקימון עם גזירה יכול לקצוץ אותם, לפתוח מסלולים חדשים שהיו חסומים בעבר."
        },
        {
          "en": "Look for marked trees on the routes — new adventures are waiting beyond them!",
          "he": "חפש עצים מסומנים בשבילים — הרפתקאות חדשות מחכות מעבר להם!"
        }
      ]
    },
    {
      "id": "gym-adda-placeholder",
      "name": "Gym Statue",
      "x": 9,
      "y": 2,
      "facing": "down",
      "type": "dialogue",
      "despawnAfter": "sumville-crystal-returned",
      "dialogue": [
        {
          "en": "A plaque reads: \"Adda — Addition Gym Leader. Gone searching for the Bridge Crystal.\"",
          "he": "לוח כתוב: \"אדה — מנהיגת מכון. יצאה לחפש את גביש הגשר.\""
        },
        {
          "en": "The gym feels empty without her. Perhaps if the crystal is returned, she'll come back.",
          "he": "מכון מרגיש ריק בלעדיה. אולי אם הגביש יוחזר, היא תחזור."
        }
      ],
      "spriteType": "npc-m"
    }

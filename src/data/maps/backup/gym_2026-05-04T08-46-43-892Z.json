  "npcs": [
    {
      "id": "npc-gym-blocker-kefel",
      "x": 11,
      "y": 16,
      "facing": "right",
      "type": "dialogue",
      "blocker": true,
      "lineOfSight": 4,
      "spawnAfter": "act2-gym-leader-called",
      "despawnAfter": "act2-wife-helped",
      "spriteType": "gate-officer",
      "dialogue": [
        {
          "en": "The gym leader is away dealing with an emergency. Please come back later.",
          "he": "מנהיג המכון נעדר עקב מצב חירום. חזור מאוחר יותר בבקשה."
        }
      ]
    },
    {
      "id": "npc-hintGuy-1234xxads",
      "x": 10,
      "y": 13,
      "facing": "down",
      "type": "dialogue",
      "dialogue": [
        {
          "en": "Hello!",
          "he": "ברוכים הבאים למכון הכפל!"
        },
        {
          "en": "",
          "he": "הפוקימונים של מכון הכפל הינם פוקימוני חרק ! נראה את ראש העכביש שלכם."
        },
        {
          "en": "",
          "he": "כדי לפגוש את קפטן קפלה עליכם לפתור חידה!"
        },
        {
          "en": "",
          "he": "אביא לכם מספר רמזים:"
        },
        {
          "en": "",
          "he": "1. כל חלל במכון נחשב בפני עצמו"
        },
        {
          "en": "",
          "he": "2. עליכם לדעת מה אורך ורוחב החלל שאתם נמצאים בו - איך? פשוט ספרו צעדים"
        },
        {
          "en": "",
          "he": "3. אתם במכון הכפל - אז תחשבו על כפל"
        },
        {
          "en": "",
          "he": "בהצלחה!"
        }
      ],
      "spriteType": "char_962c1b",
      "name": {
        "en": "Jimmy",
        "he": "ג'ימי"
      },
      "questions": {
        "repeated": true,
        "count": 5,
        "types": ["×"]
      }
    },
    {
      "id": "npc-1777879711039-hint2",
      "x": 11,
      "y": 3,
      "facing": "down",
      "type": "dialogue",
      "dialogue": [
        {
          "en": "Hello!",
          "he": "שלום !"
        },
        {
          "en": "",
          "he": "מצאתם את רוחב ואורך החלל ?"
        },
        {
          "en": "",
          "he": "מעולה! כעת חשבו מה היחס בינהם!"
        },
        {
          "en": "",
          "he": "כלומר חלקו את רוחב החדר באורכו - התוצאה מסמנת את מספר השורה מהכניסה לחלל הנוכחי!"
        }
      ],
      "spriteType": "char_5b4066",
      "name": {
        "en": "Sam",
        "he": "סם"
      },
      "questions": {
        "count": 5,
        "types": ["×"],
        "repeated": true
      }
    },
    {
      "id": "npc-1777880165783-hint3",
      "x": 8,
      "y": 17,
      "facing": "left",
      "type": "dialogue",
      "dialogue": [
        {
          "en": "Hello!",
          "he": "אני רמז מספר 3 : אם לא פתרת קודם את חלק 1 ו -2 לא בטוח שתצליחו להתקדם בכוחות עצמכם. אלא אם כן אתם בונים על המזל ."
        },
        {
          "en": "",
          "he": "אבל אם כן פתרתם עד כה כל הכבוד!"
        },
        {
          "en": "",
          "he": "כעת עליכם למצוא את היחס בין רוחב החדר הגדול למרחק ממני עד לקיר שמולי בחדר הקטן."
        },
        {
          "en": "",
          "he": "התשובה מצביעה על מספר הטור בו מופיע המעבר לרמז הבא."
        }
      ],
      "spriteType": "char_5b4066",
      "questions": {
        "count": 5,
        "types": ["×"],
        "repeated": true
      }
    },
    {
      "id": "npc-1777881222-hint4",
      "x": 22,
      "y": 17,
      "facing": "down",
      "type": "dialogue",
      "dialogue": [
        {
          "en": "Hello!",
          "he": "קפטן קלפקה ממתין לכם! המעבר ממני הוא לחדר דביק מאוד עם הרבה חורים שיחזירו אתכם אחורה."
        },
        {
          "en": "",
          "he": "החדר שתלכו אליו הוא ברוחב 8 צעדים ואורך של 7 צעדים."
        },
        {
          "en": "",
          "he": "הכפילו את הצעדים. וצעדו ימינה לפי מספר העשרות ואז למטה כמספר האחדות"
        }
      ],
      "spriteType": "char_e19d22",
      "name": {
        "en": "Clair",
        "he": "קלייר"
      },
      "questions": {
        "count": 5,
        "types": ["×"],
        "repeated": true
      }
    }
  ],

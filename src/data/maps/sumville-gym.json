  "npcs": [
    {
      "id": "gym-hint-npc",
      "name": {
        "en": "Gym Guide",
        "he": "Gym Guide"
      },
      "x": 7,
      "y": 17,
      "facing": "right",
      "type": "dialogue",
      "dialogue": [
        {
          "en": "Welcome to the Addition Gym! Three trainers guard Adda's arena.",
          "he": "ברוך הבא למכון של החיבור! הרבה מאמנים כבר הובסו בעבר. אני מקווה שאתה מספיק חזק לזכות בתג!"
        },
        {
          "en": "The path twists left then right — defeat each trainer to clear the way.",
          "he": "טיפ: תנועות מסוג נורמל לא ממש יעילות כאן. נסה סלע , מתכת או לחימה לסופר אפקטיביות!"
        },
        {
          "en": "Tip: Normal-type moves won't help here. Try Fighting or Rock types!",
          "he": ""
        }
      ],
      "spriteType": "char_9ceeb2",
      "blocker": true,
      "despawnWhenParty": {
        "count": 2,
        "minLevel": 20
      }
    },
    {
      "id": "gym-trainer-1",
      "name": {
        "en": "Gym Trainer Addi",
        "he": "Gym Trainer Addi"
      },
      "x": 2,
      "y": 13,
      "facing": "right",
      "type": "trainer",
      "dialogue": [
        {
          "en": "I add power to every battle! You'll have to get through me first!",
          "he": "אני מוסיף כוח לכל קרב! תצטרך לעבור דרכי קודם!"
        }
      ],
      "spriteType": "char_2db5a7",
      "party": [
        {
          "pokemonId": 16,
          "level": 15,
          "moves": []
        },
        {
          "pokemonId": 19,
          "level": 17,
          "moves": []
        },
        {
          "pokemonId": 39,
          "level": 20,
          "moves": []
        }
      ],
      "reward": {
        "money": 416,
        "items": [
          {
            "itemId": "potion",
            "quantity": 3
          }
        ]
      },
      "lineOfSight": 13,
      "despawnOnDefeat": true,
      "postBattleDialogue": [
        {
          "en": "The sum of your skill is greater than mine...",
          "he": "סך הכל הכישורים שלך גדולים משלי..."
        }
      ]
    },
    {
      "id": "gym-trainer-2",
      "name": {
        "en": "Gym Trainer Summa",
        "he": "Gym Trainer Summa"
      },
      "x": 15,
      "y": 9,
      "facing": "left",
      "type": "trainer",
      "dialogue": [
        {
          "en": "Two trainers down plus one equals three obstacles total. I'm obstacle two!",
          "he": "שני מאמנים בתוספת אחד שווה שלושה מכשולים בסה\"כ. אני המכשול השני!"
        }
      ],
      "spriteType": "char_a5abb0",
      "party": [
        {
          "pokemonId": 23,
          "level": 20,
          "moves": []
        },
        {
          "pokemonId": 100,
          "level": 20,
          "moves": []
        },
        {
          "pokemonId": 43,
          "level": 20,
          "moves": []
        }
      ],
      "reward": {
        "money": 448
      },
      "lineOfSight": 13,
      "despawnOnDefeat": true,
      "postBattleDialogue": [
        {
          "en": "1 + 1 + 1 = 3... and three losses for me today.",
          "he": "1 + 1 + 1 = 3... ושלוש הפסדות בשבילי היום."
        }
      ]
    },
    {
      "id": "gym-trainer-3",
      "name": {
        "en": "Gym Trainer Carry",
        "he": "Gym Trainer Carry"
      },
      "x": 2,
      "y": 5,
      "facing": "right",
      "type": "trainer",
      "dialogue": [
        {
          "en": "I always carry the one! My Pokemon have fought many trainers and added every victory!",
          "he": "אני תמיד נושא את האחת! הפוקימונים שלי נלחמו במאמנים רבים וצברו כל ניצחון!"
        }
      ],
      "spriteType": "char_485c6e",
      "party": [
        {
          "pokemonId": 20,
          "level": 20,
          "moves": []
        },
        {
          "pokemonId": 40,
          "level": 20,
          "moves": []
        },
        {
          "pokemonId": 86,
          "level": 20,
          "moves": []
        },
        {
          "pokemonId": 190,
          "level": 20,
          "moves": []
        }
      ],
      "reward": {
        "money": 480
      },
      "lineOfSight": 13,
      "despawnOnDefeat": true,
      "postBattleDialogue": [
        {
          "en": "I carried too much... You've earned the right to face Adda.",
          "he": "נשאתי יותר מדי... הרווחת את הזכות לעמוד מול אדה."
        }
      ]
    },
    {
      "id": "adda-gym-leader",
      "name": {
        "en": "Adda",
        "he": "Adda"
      },
      "x": 8,
      "y": 2,
      "facing": "down",
      "type": "trainer",
      "spriteType": "char_962c1b",
      "spawnAfter": "sumville-crystal-returned",
      "dialogue": [
        {
          "en": "I'm Adda, leader of the Addition Gym.",
          "he": "אני אדה, מנהיגת מכון של החיבור."
        },
        {
          "en": "Thanks to you, the bridge crystal is safe. Now prove your worth as a trainer!",
          "he": "בזכותך, גביש הגשר בטוח. עכשיו הוכח את ערכך כמאמן!"
        },
        {
          "en": "When all elements add together, the total is greater than any single part. Show me your sum!",
          "he": "כשכל האלמנטים מתחברים, הסך גדול מכל חלק בודד. הראה לי את הסכום שלך!"
        }
      ],
      "party": [
        {
          "pokemonId": 35,
          "level": 20,
          "moves": []
        },
        {
          "pokemonId": 39,
          "level": 22,
          "moves": []
        },
        {
          "pokemonId": 242,
          "level": 27,
          "moves": []
        },
        {
          "pokemonId": 217,

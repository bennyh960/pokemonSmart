        }
      ],
      "reward": {
        "money": 1800,
        "badge": 1,
        "storyEvent": "sumville-gym-cleared",
        "items": [
          {
            "itemId": "hm01",
            "quantity": 1
          }
        ]
      },
      "lineOfSight": 5,
      "postBattleDialogue": [
        {
          "en": "Impressive! You've earned the Sum Badge — proof of your addition of strength and wisdom.",
          "he": "מרשים! הרווחת את תג הסכום — הוכחה לחיבור הכוח והחוכמה שלך."
        },
        {
          "en": "Take this — HM01, Cut.",
          "he": "אתה מספיק חזק ללמוד שימוש בחיתוך גזירה!"
        },
        {
          "en": "Teach Cut to one of your Pokemon. In battle, it slices the target cleanly.",
          "he": "קח את זה — HM01, גזירה."
        },
        {
          "en": "But Cut's real power shines in the overworld. See those small trees with marked trunks?",
          "he": "למד גזירה לאחד מהפוקימונים שלך. בקרב, היא חותכת את המטרה בצורה נקייה."
        },
        {
          "en": "A Pokemon with Cut can slice them down, opening new paths that were blocked before.",
          "he": "אבל הכוח האמיתי של הגזירה מתגלה בעולם. רואה את העצים הקטנים עם גזעים מסומנים?"
        },
        {
          "en": "Look for marked trees on the routes — new adventures are waiting beyond them!",
          "he": "פוקימון עם גזירה יכול לקצוץ אותם, לפתוח מסלולים חדשים שהיו חסומים בעבר."
        },
        {
          "en": "",
          "he": "חפש עצים מסומנים בשבילים — הרפתקאות חדשות מחכות מעבר להם!"
        }
      ]
    }
  ],

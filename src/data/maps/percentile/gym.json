  "npcs": [
    {
      "id": "npc-pgym-riddle-1",
      "x": 11,
      "y": 16,
      "facing": "right",
      "type": "dialogue",
      "spriteType": "char_6bacac",
      "name": {
        "en": "Gym Guide Noa",
        "he": "המדריכה נועה"
      },
      "dialogue": [
        {
          "en": "Welcome to the Percentile Gym! I am so happy you came!",
          "he": "ברוך הבא למכון פרסנטייל! אני כל כך שמחה שבאת!"
        },
        {
          "en": "Here you find the leader with math. In every room a helper gives you a riddle.",
          "he": "כאן מוצאים את המנהיג בעזרת חשבון. בכל חדר יש עוזר שנותן לך חידה."
        },
        {
          "en": "The answer is the number of the pad you should step on. Ready?",
          "he": "התשובה היא המספר של המשטח שעליו צריך לעלות. מוכן?"
        },
        {
          "en": "Riddle: only 10% of challengers find our leader. Today 20 trainers came.",
          "he": "חידה: רק 10% מהמתמודדים מוצאים את המנהיג שלנו. היום הגיעו 20 מאמנים."
        },
        {
          "en": "How many of them found the leader?",
          "he": "כמה מהם מצאו את המנהיג?"
        },
        {
          "en": "The LEFT pad is 10, the UP pad is 20, the RIGHT pad is 2. Good luck!",
          "he": "המשטח השמאלי הוא 10, המשטח למעלה הוא 20, המשטח הימני הוא 2. בהצלחה!"
        },
        {
          "en": "Tip: 10% means 1 out of every 10.",
          "he": "טיפ: 10% זה 1 מכל 10."
        }
      ]
    },
    {
      "id": "npc-pgym-riddle-2",
      "x": 4,
      "y": 16,
      "facing": "left",
      "type": "dialogue",
      "spriteType": "char_dc1a34",
      "name": {
        "en": "Gym Helper Maya",
        "he": "העוזרת מאיה"
      },
      "dialogue": [
        {
          "en": "Wow, you solved it! 10% of 20 is 2. Great thinking!",
          "he": "וואו, פתרת! 10% מ-20 זה 2. חשיבה מעולה!"
        },
        {
          "en": "Next riddle: our leader trains Fire Pokémon.",
          "he": "החידה הבאה: המנהיג שלנו מאמן פוקימוני אש."
        },
        {
          "en": "How many types are super effective against Fire? You can check your Pokédex!",
          "he": "כמה סוגים יעילים במיוחד נגד אש? אפשר לבדוק בפוקידקס!"
        },
        {
          "en": "Pad at the end of the BOTTOM hall is 2. Pad at the end of the MIDDLE hall is 3. Pad at the TOP is 4.",
          "he": "המשטח בסוף המסדרון התחתון הוא 2. המשטח בסוף המסדרון האמצעי הוא 3. המשטח למעלה הוא 4."
        },
        {
          "en": "Tip: think about what puts out a fire... and what fire cannot burn.",
          "he": "טיפ: תחשוב מה מכבה אש... ומה אש לא יכולה לשרוף."
        }
      ]
    },
    {
      "id": "npc-pgym-riddle-3",
      "x": 20,
      "y": 16,
      "facing": "right",
      "type": "dialogue",
      "spriteType": "char_c32979",
      "name": {
        "en": "Gym Helper Noam",
        "he": "העוזר נועם"
      },
      "dialogue": [
        {
          "en": "Amazing! Water, Ground and Rock — 3 types. You really know your Pokémon!",
          "he": "מדהים! מים, אדמה וסלע — 3 סוגים. אתה באמת מכיר את הפוקימונים שלך!"
        },
        {
          "en": "Last riddle: a Potion heals 20 HP. Your Pokémon has 100 HP.",
          "he": "חידה אחרונה: שיקוי (Potion) מרפא 20 חיים. לפוקימון שלך יש 100 חיים."
        },
        {
          "en": "What percent of its HP does one Potion heal?",
          "he": "כמה אחוז מהחיים שלו שיקוי אחד מרפא?"
        },
        {
          "en": "BOTTOM-LEFT pad is 5. LEFT pad in the middle hall is 80. RIGHT pad in the middle hall is 50. TOP pad is 20.",
          "he": "המשטח למטה משמאל הוא 5. המשטח השמאלי במסדרון האמצעי הוא 80. המשטח הימני במסדרון האמצעי הוא 50. המשטח למעלה הוא 20."
        },
        {
          "en": "Tip: percent means \"out of 100\".",
          "he": "טיפ: אחוז זה \"מתוך 100\"."
        }
      ]
    },
    {
      "id": "npc-pgym-oops",
      "x": 13,
      "y": 3,
      "facing": "down",
      "type": "dialogue",
      "spriteType": "char_1b9be7",
      "name": {
        "en": "Gym Helper Tal",
        "he": "העוזר טל"
      },
      "dialogue": [
        {
          "en": "Oops, wrong pad! That is totally fine — mistakes help us learn.",
          "he": "אופס, משטח לא נכון! זה בסדר גמור — טעויות עוזרות ללמוד."
        },
        {
          "en": "The pad on the right takes you back to the start. Try the riddle again — you can do it!",
          "he": "המשטח מימין מחזיר אותך להתחלה. נסה שוב את החידה — אתה יכול!"
        }
      ]
    }
  ],

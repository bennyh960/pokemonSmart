  "npcs": [
    {
      "id": "house3i-pokeball-tutor",
      "name": {
        "en": "Grandma Tova",
        "he": "Grandma Tova"
      },
      "x": 3,
      "y": 4,
      "facing": "right",
      "type": "dialogue",
      "dialogue": [
        {
          "en": "Welcome to my home, dear! I used to travel all of Numeria as a young trainer.",
          "he": "ברוך הבא לביתי, יקירי! פעם טיילתי בכל נומריה כמאמנת צעירה."
        },
        {
          "en": "A Pokeball — or 'כדור פוקה' in Hebrew — is how you catch wild Pokemon.",
          "he": "כדור פוקה הוא איך שתופסים פוקימון פראיים."
        },
        {
          "en": "Throw it during a battle when the wild Pokemon's HP is low. The weaker it is, the easier to catch!",
          "he": "זרוק אותו במהלך קרב כשה-HP של הפוקימון הפראי נמוך. ככל שהוא חלש יותר, כך קל יותר לתפוס!"
        },
        {
          "en": "Great Balls and Ultra Balls catch even better — buy them at the Mart when you have enough money.",
          "he": "כדורים גדולים וכדורים אולטרה תופסים אפילו טוב יותר — קנה אותם בחנות כשיש לך מספיק כסף."
        }
      ],
      "spriteType": "char_8c60a6",
      "reward": {
        "items": [
          {
            "itemId": "poke-ball",
            "quantity": 3
          }
        ],
        "flag": "house3i-grandma-rewarded"
      }
    },
    {
      "id": "house3i-battle-tutor",
      "name": {
        "en": "Young Trainer Dov",
        "he": "Young Trainer Dov"
      },
      "x": 9,
      "y": 5,
      "facing": "left",
      "type": "dialogue",
      "dialogue": [
        {
          "en": "Hey! I'm studying hard to become a great trainer.",
          "he": "היי! אני לומד קשה כדי להיות מאמן מעולה."
        },
        {
          "en": "In a Pokemon battle, you pick one of four moves each turn. Pick the right type and deal extra damage!",
          "he": "בקרב פוקימון, אתה בוחר אחד מארבעה מהלכים בכל תור. בחר את הסוג הנכון ותגרום נזק נוסף!"
        },
        {
          "en": "Fire beats Grass. Water beats Fire. Grass beats Water. Simple as that for starters!",
          "he": "אש מנצחת עשב. מים מנצחים אש. עשב מנצח מים. פשוט ככה בהתחלה!"
        }
      ],
      "spriteType": "char_0502ea"
    }
  ]

    {
      "id": "npc-1774902306699",
      "name": { "en": "Jasmine", "he": "Jasmine" },
      "x": 10,
      "y": 3,
      "facing": "down",
      "type": "dialogue",
      "dialogue": [
        { "en": "Hi there! I am Jasmine. My research is all about Pokemon experience.", "he": "שלום! אני ג'סמין. המחקר שלי עוסק בניסיון של פוקימון." },
        { "en": "The more a Pokemon battles, the more EXP — experience points — it earns. EXP helps it grow stronger and level up!", "he": "ככל שפוקימון נלחם יותר, כך הוא צובר יותר EXP — נקודות ניסיון. EXP עוזר לו להתחזק ולעלות רמה!" },
        { "en": "Your Pokemon gains EXP even if it helps you catch a wild Pokemon. Every battle counts!", "he": "הפוקימון שלך צובר EXP אפילו אם הוא עוזר לך לתפוס פוקימון פראי. כל קרב חשוב!" },
        { "en": "Take this Pokeball — practice catching is the best way to start!", "he": "קח את כדור הפוקה הזה — תרגול תפיסה הוא הדרך הטובה ביותר להתחיל!" }
      ],
